rules_version = '2';

// כללי אבטחה ל-Firestore: כל גישה (קריאה/כתיבה) מותרת רק לבני המשפחה
// שהמייל שלהם ברשימה למטה. העתיקו קובץ זה ל-Firebase Console →
// Firestore Database → Rules, ופרסמו (Publish).
//
// *** ערכו את רשימת המיילים כאן בעת הוספה/הסרה של בן משפחה, ופרסמו מחדש. ***
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamilyMember() {
      return request.auth != null && request.auth.token.email in [
        'zigman.tal@gmail.com'
        // הוסיפו כאן מיילים נוספים של בני משפחה, מופרדים בפסיק, לדוגמה:
        // , 'spouse@gmail.com'
        // , 'kid@gmail.com'
      ];
    }

    match /categories/{categoryId} {
      allow read, write: if isFamilyMember();
    }

    match /catalogItems/{itemId} {
      allow read, write: if isFamilyMember();
    }

    match /lists/{listId} {
      allow read, write: if isFamilyMember();

      match /items/{itemId} {
        allow read, write: if isFamilyMember();
      }
    }
  }
}
